# RDS PostgreSQL: subnet group, security group and instance.

# --- RDS PostgreSQL ---

resource "aws_db_subnet_group" "this" {
  name       = "${var.project-tag}-db"
  subnet_ids = [for s in aws_subnet.private_data : s.id]

  tags = {
    Name     = "${var.project-tag}-db-subnets"
    projects = var.project-tag
  }
}

resource "aws_security_group" "rds" {
  name        = "${var.project-tag}-rds-sg"
  description = "RDS PostgreSQL; ingress from private-app subnets only"
  vpc_id      = aws_vpc.uniflow_vpc.id

  tags = {
    Name     = "${var.project-tag}-rds-sg"
    projects = var.project-tag
  }
}

resource "aws_vpc_security_group_ingress_rule" "rds_from_private_app" {
  for_each = local.private_app_subnets

  security_group_id = aws_security_group.rds.id
  description       = "PostgreSQL from private-app ${each.key}"
  cidr_ipv4         = each.value.cidr
  ip_protocol       = "tcp"
  from_port         = 5432
  to_port           = 5432
}

resource "aws_db_instance" "postgres" {
  identifier = "${var.project-tag}-postgres"

  engine         = "postgres"
  engine_version = var.rds_engine_version
  instance_class = var.rds_instance_class

  allocated_storage     = var.rds_allocated_storage
  max_allocated_storage = var.rds_max_allocated_storage
  storage_type          = "gp3"
  storage_encrypted     = true
  kms_key_id            = aws_kms_key.shared.arn

  db_name  = var.rds_db_name
  username = var.rds_master_username
  # Password is generated by RDS and stored in Secrets Manager; never in state.
  manage_master_user_password = true

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = false
  multi_az               = var.rds_multi_az

  backup_retention_period    = var.rds_backup_retention_days
  copy_tags_to_snapshot      = true
  auto_minor_version_upgrade = true
  deletion_protection        = var.rds_deletion_protection
  skip_final_snapshot        = var.rds_skip_final_snapshot
  final_snapshot_identifier  = var.rds_skip_final_snapshot ? null : "${var.project-tag}-postgres-final"

  enabled_cloudwatch_logs_exports = ["postgresql", "upgrade"]

  tags = {
    Name     = "${var.project-tag}-postgres"
    projects = var.project-tag
  }
}
